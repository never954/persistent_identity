{
  "name": "ravenswood",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ravenswood Manor - a candlelit detective game with fallible-memory AI suspects",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "render:shots": "esbuild scripts/renderEntry.ts --bundle --platform=node --format=esm --outfile=scripts/_bundle.mjs --log-level=warning && node scripts/runRender.mjs",
    "annotate:shots": "python3 scripts/annotate.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
